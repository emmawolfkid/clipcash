# Copy this file to .env and replace every placeholder. Never commit .env.

# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=clipcash_db
DB_USER=clipcash_user
DB_PASSWORD=replace-with-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
# Disposable test database (see scripts/database/create_test_database.sql).
# DB_TEST_NAME=test_clipcash_db

# --- Optional; defaults suit local development --------------------------------

# Cache used for rate limiting. Production needs a shared cache, e.g.
#   dbcache://clipcash_cache   (then: python manage.py createcachetable)
# DJANGO_CACHE_URL=locmemcache://clipcash
# Defaults to True when DJANGO_DEBUG is False.
# DJANGO_THROTTLE_REQUIRE_SHARED_CACHE=False
# Number of trusted reverse proxies in front of Django (0 ignores X-Forwarded-For).
# DJANGO_TRUSTED_PROXY_COUNT=0

# Cookies and HTTPS. Secure cookies default to on when DJANGO_DEBUG is False.
# DJANGO_SECURE_COOKIES=False
# DJANGO_SESSION_COOKIE_AGE=43200
# DJANGO_CSRF_TRUSTED_ORIGINS=https://clipcash.example
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_PROXY_SSL_HEADER=False

# Email
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=ClipCash <no-reply@localhost>

# DJANGO_SECURITY_LOG_LEVEL=INFO
