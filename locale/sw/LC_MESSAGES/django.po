msgid "Add a mobile number"
msgstr "Ongeza namba ya simu"

#: templates/accounts/profile.html
msgid "Add a recovery email address"
msgstr "Ongeza anwani ya barua pepe ya kurejesha akaunti"

#: templates/components/contact_verification_notice.html
