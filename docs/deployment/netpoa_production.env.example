# ClipCash public production on NetPoa: template for ~/clipcash/app/.env (mode 600).
# See docs/deployment/netpoa_public_runbook.md §6. Copy it to the server only, replace every <placeholder>,
# never commit the result, never paste values into tickets, chats or the Setup Python App page.
# `python manage.py check --deploy --fail-level ERROR` refuses this file until the placeholders are replaced.
#
# Values marked STAGE change only at the stage named; everything else is set once at Stage 1.

# --- Core -------------------------------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(64))"   (new value; never reuse another key)
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=False
# Exact host names only (no wildcards). Add www. only if it serves the app too.
DJANGO_ALLOWED_HOSTS=<domain>.co.tz
DJANGO_CSRF_TRUSTED_ORIGINS=https://<domain>.co.tz
# Origin put in emailed activation and password-reset links (https, scheme and host only,
# a host listed in DJANGO_ALLOWED_HOSTS). Required in public production (core.E009).
DJANGO_PUBLIC_BASE_URL=https://<domain>.co.tz

# --- Database: the RUNTIME login only (never the owner login) ---------------------------------------
# Letters and digits in the password avoid URL-escaping problems.
DATABASE_URL=postgresql://<account>_ccapp:<runtime password>@localhost:5432/<account>_clipcash
# Local socket/localhost needs no TLS; set require/verify-full only for a remote database.
# DJANGO_DB_SSLMODE=require

# --- Cache and rate limits (shared across Passenger processes) --------------------------------------
DJANGO_CACHE_URL=dbcache://clipcash_cache

# --- HTTPS and proxy (choose per netpoa_public_compatibility.md C1; verify on /manage/health/) -------
DJANGO_SECURE_SSL_REDIRECT=True
# False when Passenger itself receives HTTPS (Cloudflare "Full (strict)" or AutoSSL without a TLS-ending proxy).
DJANGO_SECURE_PROXY_SSL_HEADER=False
# 0 until HTTPS has worked for a week; then raise in a reviewed change.
DJANGO_SECURE_HSTS_SECONDS=0
# Case A (Cloudflare in front, web server passes Cloudflare's address): count 1 + Cloudflare's ranges.
DJANGO_TRUSTED_PROXY_COUNT=1
DJANGO_TRUSTED_PROXY_NETWORKS=<Cloudflare IPv4 and IPv6 ranges from https://www.cloudflare.com/ips/, comma-separated>
# Case B (no proxy, or the web server already rewrites the client address): count 0 and no networks.
# DJANGO_TRUSTED_PROXY_COUNT=0

# --- Launch stages ------------------------------------------------------------------------------------
# Production mode: never the restricted demonstration.
DJANGO_RESTRICTED_DEMO=False
# STAGE 2: set to True only after registration acceptance. Until then registration is closed
# (check --deploy reports core.W003, which is expected at Stage 1).
DJANGO_PUBLIC_REGISTRATION_APPROVED=False
# Sandbox and live gateway payments never run in production.
DJANGO_PAYMENTS_MODE=disabled
# STAGE 3: uncomment only with the owner's written authorization (real Airtel Lipa payments).
# DJANGO_MANUAL_MEMBERSHIP_PAYMENTS=True

# --- Email (required: activation and password-reset links) ------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=<smtp host>
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
# For port 465 instead: DJANGO_EMAIL_USE_TLS=False and DJANGO_EMAIL_USE_SSL=True
DJANGO_EMAIL_HOST_USER=<smtp user>
DJANGO_EMAIL_HOST_PASSWORD=<smtp password>
DJANGO_DEFAULT_FROM_EMAIL=ClipCash <no-reply@<domain>.co.tz>

# --- Videos (Bunny Stream; Embed view token authentication ON in Bunny) -----------------------------
VIDEO_PROVIDER=bunny
BUNNY_STREAM_LIBRARY_ID=<library id>
BUNNY_STREAM_API_KEY=<library API key>
BUNNY_STREAM_CDN_HOSTNAME=<vz-xxxxxxxx-xxx.b-cdn.net>
BUNNY_STREAM_TOKEN_SECURITY_KEY=<token authentication key>

# --- Optional ----------------------------------------------------------------------------------------
# Only if cron runs every 5 minutes instead of every minute:
# DJANGO_JOBS_HEARTBEAT_STALE_SECONDS=900
# Owner-approved ceiling for plan prices (default TZS 100,000,000):
# DJANGO_MEMBERSHIPS_MAX_PLAN_PRICE=100000000

# --- NEVER set in public production --------------------------------------------------------------------
# DJANGO_DEBUG=True, DJANGO_RESTRICTED_DEMO=True, DJANGO_PAYMENTS_MODE=sandbox, DJANGO_PAYMENTS_SANDBOX_ALLOWED,
# DJANGO_MEMBERSHIPS_COMPLIMENTARY_GRANTS, DJANGO_DEMO_EMAIL_VERIFICATION_OPTIONAL, DJANGO_DEMO_ACCOUNTS,
# VIDEO_DEMO_ALLOWED, DJANGO_PROXY_ORIGIN_RESTRICTED (unless the origin is locked to the proxy), a console,
# locmem, file or dummy email backend, or the database OWNER login.
