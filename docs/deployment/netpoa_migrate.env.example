# ClipCash on NetPoa: MIGRATION login overrides (PRD-00B). Template for ~/clipcash/secrets/migrate.env
# (mode 600, OUTSIDE the application directory and public_html). Never commit the real file.
#
# The application's .env names the RUNTIME login. Migrations, the login check and the restore
# drill need the MIGRATION login, which owns the tables and the guard triggers. Load this file
# only for those commands, in a subshell, so nothing else ever runs with it:
#
#   ( set -a; . ~/clipcash/secrets/migrate.env; set +a; python manage.py migrate --plan )
#
# Values set here win over .env (config.settings reads .env without overriding the environment).
# The password never appears on a command line, in shell history or in a crontab.

DB_USER=<account>_ccmigrate
DB_PASSWORD=<migration password>
# The runtime login again, so `manage.py check_mariadb_logins` can test BOTH logins:
DB_RUNTIME_USER=<account>_ccapp
DB_RUNTIME_PASSWORD=<runtime password>
